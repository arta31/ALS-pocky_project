<?xml version="1.0" encoding="utf-8"?>
<!-- Progres 6 (P11): latar Beranda = warna dasar + setengah lingkaran di atas -->
<!-- 💡 BARU: layer-list = beberapa shape ditumpuk (item atas digambar di bawah, item bawah di atas) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Warna dasar halaman -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_page" />
        </shape>
    </item>

    <!-- 2. Lingkaran besar biru muda, digeser ke atas (top negatif) sehingga terlihat setengah -->
    <item
        android:width="560dp"
        android:height="560dp"
        android:gravity="top|center_horizontal"
        android:top="-360dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@color/primary_50"
                android:startColor="@color/primary_100" />
        </shape>
    </item>

    <!-- 3. Lingkaran emas transparan kecil di pojok kanan atas -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="top|end"
        android:right="-50dp"
        android:top="-40dp">
        <shape android:shape="oval">
            <solid android:color="#33FBBF24" />
        </shape>
    </item>
</layer-list>