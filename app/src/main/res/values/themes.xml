<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema aplikasi SEMAWIT (selalu mode terang agar warna konsisten) -->
    <style name="Base.Theme.ALSpocky" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorOnPrimary">@color/neutral_0</item>
        <item name="colorPrimaryContainer">@color/primary_100</item>
        <item name="colorOnPrimaryContainer">@color/primary_800</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/primary_800</item>
        <item name="colorSurface">@color/neutral_0</item>
        <item name="colorOnSurface">@color/neutral_900</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ALSpocky" parent="Base.Theme.ALSpocky" />

    <!-- Bottom nav ala Figma: tanpa pill, item aktif cukup berwarna navy -->
    <style name="SemawitBottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
