<?xml version="1.0" encoding="utf-8"?>
<!-- Activity utama setelah login: wadah fragment + bottom navigation + tombol + di tengah -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- Tempat fragment ditampilkan (diganti lewat replaceFragment) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/SemawitBottomNavIndicator"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextAppearanceActive="@style/TextAppearance.Semawit.NavActive"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Tombol + di tengah bottom nav -> membuka menu Panen.
         elevation lebih tinggi dari bottom nav agar tampil di atasnya. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPanen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="Input Panen"
        android:src="@drawable/ic_add"
        android:translationY="-16dp"
        app:backgroundTint="@color/primary_500"
        app:elevation="12dp"
        app:fabCustomSize="58dp"
        app:maxImageSize="28dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Semawit.Fab"
        app:tint="@color/neutral_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomNavView" />

</androidx.constraintlayout.widget.ConstraintLayout>
