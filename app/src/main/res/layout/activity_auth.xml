<?xml version="1.0" encoding="utf-8"?>
<!-- Login: latar terang, judul besar, input bersudut bulat, tombol Masuk -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo kecil dalam kotak putih -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Semawit.Card"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_logo_semawit" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Semawit.Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Masuk ke\nakun kamu" />

        <TextView
            style="@style/Semawit.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gunakan username terdaftar untuk melanjutkan." />

        <TextView
            style="@style/Semawit.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Username"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Semawit.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:startIconDrawable="@drawable/ic_nav_akun"
            app:startIconTint="@color/neutral_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan username"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Semawit.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kata sandi"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Semawit.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/neutral_500">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan kata sandi"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Semawit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Masuk" />
        <!-- Pemisah -->
        <TextView
            style="@style/Semawit.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="atau" />

        <!-- Tombol Register With Gmail -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterGmail"
            style="@style/Semawit.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Register With Gmail"
            app:icon="@drawable/ic_mail" />

        <TextView
            style="@style/Semawit.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="SEMAWIT v1.0 • Kelola panen, tabung lebih tenang"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
