<?xml version="1.0" encoding="utf-8"?>
<!-- Riwayat: Kalender Panen (fitur baru) + daftar transaksi -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Semawit.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp">

            <TextView
                style="@style/Semawit.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ketuk tanggal untuk melihat panen di hari itu." />

            <!-- ========== KALENDER PANEN ========== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Semawit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header: ‹ Oktober 2026 › -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnBulanSebelum"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_tile"
                            android:contentDescription="Bulan sebelumnya"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/primary_500" />

                        <TextView
                            android:id="@+id/tvBulan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserrat_bold"
                            android:gravity="center"
                            android:text="Oktober 2026"
                            android:textColor="@color/neutral_900"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/btnBulanBerikut"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_tile"
                            android:contentDescription="Bulan berikutnya"
                            android:padding="8dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/primary_500" />
                    </LinearLayout>

                    <!-- Nama hari (Sen, Sel, ...) diisi dari kode -->
                    <LinearLayout
                        android:id="@+id/layoutNamaHari"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal" />

                    <!-- CalendarView dari library kizitonwose/Calendar -->
                    <com.kizitonwose.calendar.view.CalendarView
                        android:id="@+id/calendarView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cv_dayViewResource="@layout/item_calendar_day"
                        app:cv_daySize="rectangle"
                        app:cv_orientation="horizontal"
                        app:cv_outDateStyle="endOfGrid"
                        app:cv_scrollPaged="true" />

                    <!-- Keterangan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_gold" />

                        <TextView
                            style="@style/Semawit.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Hari panen"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="20dp"
                            android:background="@drawable/bg_day_today" />

                        <TextView
                            style="@style/Semawit.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Hari ini"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFilter"
                    style="@style/Semawit.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Semua transaksi" />

                <TextView
                    android:id="@+id/tvTampilkanSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Tampilkan semua"
                    android:textColor="@color/primary_400"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Kosong -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKosong"
                style="@style/Semawit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="14dp"
                        android:src="@drawable/ic_nav_riwayat"
                        app:tint="@color/primary_500" />

                    <TextView
                        android:id="@+id/tvKosongJudul"
                        style="@style/Semawit.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Belum ada transaksi" />

                    <TextView
                        android:id="@+id/tvKosongIsi"
                        style="@style/Semawit.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tekan tombol + di bawah untuk\nmencatat panen pertama." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daftar: baris transaksi ditambahkan dari kode (addView) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDaftar"
                style="@style/Semawit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/containerRiwayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
